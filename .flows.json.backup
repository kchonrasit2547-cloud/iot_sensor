        "z": "746e438bb151500f",
        "name": "function 3",
        "func": "let d = msg.payload;\n\nmsg.topic = `\nINSERT INTO sensor_data\n(\n    temperature,\n    humidity,\n    light\n)\nVALUES (?, ?, ?)\n`;\n\nmsg.payload = [\n    d.temperature,\n    d.humidity,\n    d.light\n];\n\nreturn msg;",
