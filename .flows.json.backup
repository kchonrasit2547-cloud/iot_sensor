    {
        "id": "e5115651e4eb1353",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "function 5",
        "func": "msg.topic = `\nSELECT\n    id,\n    device_time,\n    phase_id,\n    voltage,\n    current,\n    power,\n    energy,\n    recorded_at\nFROM pzem_3phase_logs\nORDER BY recorded_at DESC\nLIMIT 10000\n`;\nreturn msg;",
