    {
        "id": "90805ce04b77a3ce",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "format for database",
        "func": "let d = msg.payload;\n\n// แปลง JSON String เป็น Object หากโหนด MQTT In ยังส่งมาเป็นข้อความ\nif (typeof d === 'string') {\n    try {\n        d = JSON.parse(d);\n    } catch (e) {\n        node.error(\"Invalid JSON format\", msg);\n        return null;\n    }\n}\n\nmsg.topic = `\nINSERT INTO sensor_data\n(\n    temperature,\n    humidity,\n    light\n)\nVALUES (?, ?, ?)\n`;\n\nmsg.payload = [\n    d.temperature !== undefined ? d.temperature : 0,\n    d.humidity !== undefined ? d.humidity : 0,\n    d.light !== undefined ? d.light : 0\n];\n\nreturn msg;",
