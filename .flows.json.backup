    {
        "id": "0f9e5e0391a2d2b2",
        "type": "http in",
        "z": "746e438bb151500f",
        "name": "",
        "url": "/api/pzem-data",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 130,
        "y": 1060,
        "wires": [
            [
                "77418dbd40aa7cd6"
            ]
        ]
    },
    {
        "id": "4fa3768e4d0a54d4",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "function 6",
        "func": "const rows = msg.payload;\n\nif (!Array.isArray(rows) || rows.length === 0) {\n    msg.payload = {\n        success: false,\n        message: \"ไม่พบข้อมูล PZEM ใน Database\"\n    };\n    msg.statusCode = 404;\n    return msg;\n}\n\n// ฟังก์ชันช่วยค้นหาแถวล่าสุดตาม phase_id (1, 2, 3)\nconst getPhaseData = (phaseId) => {\n    const row = rows.find(r => Number(r.phase_id) === phaseId);\n    \n    if (!row) {\n        return {\n            voltage: 0,\n            current: 0,\n            power: 0,\n            energyWh: 0,\n            energyKwh: 0,\n            timestamp: null\n        };\n    }\n\n    return {\n        voltage: Number(row.voltage || 0),\n        current: Number(row.current || 0),\n        power: Number(row.power || 0),\n        energyWh: Number(row.energy || 0),\n        energyKwh: Number(row.energy || 0) / 1000,\n        timestamp: row.recorded_at || row.device_time\n    };\n};\n\n// ดึงข้อมูลแยกตาม phase_id\nconst l1 = getPhaseData(1);\nconst l2 = getPhaseData(2);\nconst l3 = getPhaseData(3);\n\nconst totalPower = l1.power + l2.power + l3.power;\nconst totalEnergy = l1.energyKwh + l2.energyKwh + l3.energyKwh;\n\n// ดึง timestamp ล่าสุดที่มีอยู่\nconst latestTimestamp = [l1, l2, l3].map(p => p.timestamp).find(Boolean) || new Date().toLocaleString('th-TH');\n\nmsg.payload = {\n    success: true,\n    phases: { l1, l2, l3 },\n    l1,\n    l2,\n    l3,\n    totalPower,\n    totalEnergy,\n    timestamp: latestTimestamp\n};\n\nmsg.headers = {\n    \"Content-Type\": \"application/json; charset=utf-8\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 1060,
        "wires": [
            [
                "d6433a9ef4a3a2da"
            ]
        ]
    },
    {
        "id": "77418dbd40aa7cd6",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "function 7",
        "func": "// กำหนดคำสั่ง SQL เพื่อดึงข้อมูล 15 แถวล่าสุดมาจัดกลุ่ม 3 เฟส\nmsg.topic = \"SELECT * FROM pzem_3phase_logs ORDER BY id DESC LIMIT 15;\";\nreturn msg;",
