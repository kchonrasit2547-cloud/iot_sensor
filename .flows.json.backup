    {
        "id": "1457a55b2ef1fcb4",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "function 2",
        "func": "let temp = msg.payload.temperature;\nlet light = msg.payload.light;\n\nlet tempAlert = temp <= 19;\nlet lightAlert = light > 300;\n\nlet alerts = [];\n\n// Temperature\nif (tempAlert && context.get(\"tempAlert\") !== true) {\n    alerts.push(`🌡️ อุณหภูมิต่ำ: ${temp} °C`);\n}\n\n// Light\nif (lightAlert && context.get(\"lightAlert\") !== true) {\n    alerts.push(`💡 แสงสูง: ${light}`);\n}\n\n// บันทึกสถานะปัจจุบัน\ncontext.set(\"tempAlert\", tempAlert);\ncontext.set(\"lightAlert\", lightAlert);\n\n// ไม่มีเหตุการณ์ใหม่\nif (alerts.length === 0) {\n    return null;\n}\n\nmsg.payload = {\n    chatId: 8602127088,\n    type: \"message\",\n    content: \"🚨 แจ้งเตือน IoT\\n\\n\" + alerts.join(\"\\n\")\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 180,
        "wires": [
            [
                "f79c6f4318e5037e"
            ]
        ]
    },
