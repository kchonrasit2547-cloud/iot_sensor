    {
        "id": "6b9964707bb09fa4",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "function 9",
        "func": "msg.headers = {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, POST, OPTIONS\",\n    \"Access-Control-Allow-Headers\": \"Content-Type\"\n};\n\nif (Array.isArray(msg.payload)) {\n    msg.payload = msg.payload.map(row => ({\n        id: row.id,\n        temp: row.temp ?? row.temperature ?? null,\n        humi: row.humi ?? row.humidity ?? null,\n        light: row.light ?? row.lux ?? row.ldr ?? null,\n        recorded_at: row.recorded_at || row.created_at || new Date().toISOString()\n    }));\n} else {\n    msg.payload = [];\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 1140,
        "wires": [
            [
                "46f1bae46105172f"
            ]
        ]
    },
    {
        "id": "6e9d58e8fee3dc40",
        "type": "inject",
        "z": "746e438bb151500f",
        "name": "",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{   \"l1\": { \"voltage\": 220, \"current\": 16.50 } }",
        "payloadType": "json",
        "x": 70,
        "y": 280,
        "wires": [
            [
                "1457a55b2ef1fcb4"
            ]
        ]
    },
    {
        "id": "f5db39a9b7c0a377",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "Format for Web",
        "func": "// ดึงเวลาปัจจุบันในรูปแบบ YYYY-MM-DD HH:mm:ss\nconst now = new Date().toISOString().slice(0, 19).replace('T', ' ');\nconst data = msg.payload;\n\n// กรณีที่ 1: รับข้อมูลพร้อมกัน 3 เฟส { l1: {...}, l2: {...}, l3: {...} }\nif (data.l1 || data.l2 || data.l3) {\n    let inserts = [];\n    [1, 2, 3].forEach(phaseId => {\n        const p = data[`l${phaseId}`];\n        if (p) {\n            const volt = p.v ?? p.voltage ?? 0;\n            const curr = p.i ?? p.current ?? 0;\n            const watt = p.p ?? p.power ?? 0;\n            const kwh = p.e ?? p.energy ?? 0;\n            \n            inserts.push(`('${now}', '${now}', ${phaseId}, ${volt}, ${curr}, ${watt}, ${kwh})`);\n        }\n    });\n\n    if (inserts.length > 0) {\n        msg.topic = `INSERT INTO pzem_telemetry (device_time, recorded_at, phase_id, voltage, current, power, energy) VALUES ${inserts.join(', ')}`;\n    }\n} \n// กรณีที่ 2: รับข้อมูลมาทีละเฟสแบบเดี่ยว { phase_id: 1, voltage: 230, ... }\nelse {\n    const phaseId = data.phase_id || data.phase || 1;\n    const volt = data.voltage ?? data.v ?? 0;\n    const curr = data.current ?? data.i ?? 0;\n    const watt = data.power ?? data.p ?? 0;\n    const kwh = data.energy ?? data.e ?? 0;\n\n    msg.topic = `INSERT INTO pzem_telemetry (device_time, recorded_at, phase_id, voltage, current, power, energy) VALUES ('${now}', '${now}', ${phaseId}, ${volt}, ${curr}, ${watt}, ${kwh})`;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1480,
        "y": 160,
        "wires": [
            [
                "165258d8a4275e75"
            ]
        ]
