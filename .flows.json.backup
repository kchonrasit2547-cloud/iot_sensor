    {
        "id": "func_web_route",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "Route Web File",
        "func": "const allowed = {\n    'dashboard.html': 'dashboard.html',\n    'analytics.html': 'analytics.html',\n    'energy.html': 'energy.html',\n    'history.html': 'history.html',\n    'settings.html': 'settings.html',\n    'style.css': 'style.css',\n    'common.js': 'common.js'\n};\n\nlet requested = (msg.req.params && msg.req.params.file) ? msg.req.params.file : '';\n\n// Redirect /web or /web/ to /web/dashboard.html for clean relative paths\nif (!requested || requested === '') {\n    msg.statusCode = 302;\n    msg.headers = { 'Location': '/web/dashboard.html' };\n    msg.payload = 'Redirecting...';\n    return [null, msg];\n}\n\nlet target = allowed[requested] || 'dashboard.html';\nmsg.filename = 'c:/Users/ASUS TUF/.node-red/' + target;\n\nif (target.endsWith('.css')) {\n    msg.headers = { 'content-type': 'text/css; charset=utf-8' };\n} else if (target.endsWith('.js')) {\n    msg.headers = { 'content-type': 'application/javascript; charset=utf-8' };\n} else {\n    msg.headers = { 'content-type': 'text/html; charset=utf-8' };\n}\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
