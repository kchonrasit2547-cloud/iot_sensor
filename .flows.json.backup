        "id": "c0558de9b3255841",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "function 1",
        "func": "let time = Date.now();\n\nreturn [\n    {\n        topic: \"Temperature\",\n        payload: msg.payload.temperature,\n        timestamp: time\n    },\n    {\n        topic: \"Humidity\",\n        payload: msg.payload.humidity,\n        timestamp: time\n    },\n    {\n        topic: \"Light\",\n        payload: msg.payload.light,\n        timestamp: time\n    }\n];",
