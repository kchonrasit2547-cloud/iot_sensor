    {
        "id": "6237c152082f5b61",
        "type": "mqtt in",
        "z": "746e438bb151500f",
        "name": "",
        "topic": "ku/engineering/power3phase/data/+/+",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "56f173cb94846bf2",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 1130,
        "y": 120,
        "wires": [
            [
                "58eb1fde93acfb25",
                "1457a55b2ef1fcb4",
                "f5db39a9b7c0a377"
            ]
        ]
    },
    {
        "id": "58eb1fde93acfb25",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "format for database",
        "func": "// ดึง topic เช่น ku/engineering/power3phase/data/1/volt\nvar parts = msg.topic.split('/');\nif (parts.length < 6) return null;\n\nvar phaseId = parts[4];   // \"1\", \"2\", หรือ \"3\"\nvar metric  = parts[5];   // \"volt\", \"amp\", \"watt\", \"energy_wh\"\nvar val     = parseFloat(msg.payload);\n\nif (isNaN(val)) return null;\n\n// ฟังก์ชันดึงเวลาปัจจุบันของ Node-RED Server (YYYY-MM-DD HH:mm:ss)\nfunction getServerTime() {\n    var now = new Date();\n    var pad = function(n) { return String(n).padStart(2, '0'); };\n    return now.getFullYear() + '-' +\n           pad(now.getMonth() + 1) + '-' +\n           pad(now.getDate()) + ' ' +\n           pad(now.getHours()) + ':' +\n           pad(now.getMinutes()) + ':' +\n           pad(now.getSeconds());\n}\n\n// ใช้งาน memory ของ flow เพื่อเก็บค่าและสถานะการรับข้อมูลต่อเฟส\nvar storeKey = \"phase_\" + phaseId;\nvar data = flow.get(storeKey) || {\n    phase: parseInt(phaseId),\n    volt: null,\n    amp: null,\n    watt: null,\n    energy_wh: null,\n    updated: { volt: false, amp: false, watt: false, energy_wh: false }\n};\n\n// 🟢 เพิ่มสแกนป้องกัน Error: สร้างวัตถุ updated ทันทีถ้าข้อมูลใน Memory ยังเป็นโครงสร้างรุ่นเก่า\nif (!data.updated) {\n    data.updated = { volt: false, amp: false, watt: false, energy_wh: false };\n}\n\n// อัปเดตค่าและปัก Flag ว่าได้รับค่านั้นแล้ว\nif (metric === \"volt\")      { data.volt = val;      data.updated.volt = true; }\nif (metric === \"amp\")       { data.amp = val;       data.updated.amp = true; }\nif (metric === \"watt\")      { data.watt = val;      data.updated.watt = true; }\nif (metric === \"energy_wh\") { data.energy_wh = val; data.updated.energy_wh = true; }\n\nflow.set(storeKey, data);\n\n// ตรวจสอบว่าเฟสนี้ได้รับค่าครบทั้ง 4 พารามิเตอร์ของรอบปัจจุบันแล้วหรือยัง\nif (data.updated.volt && data.updated.amp && data.updated.watt && data.updated.energy_wh) {\n    var currentTimestamp = getServerTime();\n\n    /* เก็บค่าล่าสุดของแต่ละเฟสไว้ให้หน้าเว็บ / API อ่าน */\n    flow.set(\"pzem_latest_phase_\" + phaseId, {\n        phase: data.phase,\n        timestamp: currentTimestamp,\n        volt: data.volt,\n        amp: data.amp,\n        watt: data.watt,\n        energy_wh: data.energy_wh\n    });\n\n    // ประกอบคำสั่ง SQL INSERT\n    var sql = \"INSERT INTO pzem_3phase_logs (device_time, phase_id, voltage, current, power, energy) VALUES ('\"\n              + currentTimestamp + \"', \" \n              + data.phase + \", \" \n              + data.volt + \", \" \n              + data.amp + \", \" \n              + data.watt + \", \" \n              + data.energy_wh + \");\";\n\n    // รีเซ็ต Flag การรับค่าของเฟสนี้ เพื่อเตรียมพร้อมรับข้อมูลในรอบถัดไป\n    data.updated = { volt: false, amp: false, watt: false, energy_wh: false };\n    flow.set(storeKey, data);\n    \n    return { \n        topic: sql, \n        payload: sql \n    };\n}\n\nreturn null; // รอข้อความถัดไป",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1520,
        "y": 80,
        "wires": [
            [
                "6f175eeca5d5d76b"
            ]
        ]
    },
    {
        "id": "6f175eeca5d5d76b",
        "type": "mysql",
        "z": "746e438bb151500f",
        "mydb": "c7c7ac6af60dbc9b",
        "name": "",
        "x": 1800,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "ws_prep_func",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "Format for Web",
        "func": "let p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch(e) {}\n}\nif (!p || typeof p !== 'object') {\n    p = {};\n}\n\nlet out = {\n    // Environmental\n    temperature: p.temperature !== undefined ? p.temperature : p.temp,\n    humidity: p.humidity !== undefined ? p.humidity : p.humi,\n    light: p.light !== undefined ? p.light : p.ldr,\n\n\n    topic: msg.topic || p.topic,\n    timestamp: Date.now()\n};\n\nmsg.payload = JSON.stringify(out);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 40,
        "wires": [
            [
                "ws_out_01"
            ]
        ]
    },
