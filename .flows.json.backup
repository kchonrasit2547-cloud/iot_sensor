    {
        "id": "efcf6c070fad4b73",
        "type": "ui-template",
        "z": "746e438bb151500f",
        "group": "",
        "page": "7f0850ace1152bee",
        "ui": "dfb9a6f1a1ccc731",
        "name": "Page 1 Style",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<style>\n/* ===== Page 1 - Clean Dark Theme ===== */\n\n/* Page background */\n.nrdb-page {\n    background: #0f172a !important;\n    font-family: 'Inter', 'Segoe UI', sans-serif !important;\n}\n\n/* Group card */\n.nrdb-ui-group {\n    background: #1e293b !important;\n    border: 1px solid #334155 !important;\n    border-radius: 14px !important;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4) !important;\n    overflow: hidden !important;\n    transition: box-shadow 0.3s ease;\n}\n\n.nrdb-ui-group:hover {\n    box-shadow: 0 6px 28px rgba(56, 189, 248, 0.12) !important;\n}\n\n/* Group title bar */\n.nrdb-ui-group .v-card-title,\n.nrdb-ui-group .nrdb-ui-group-name {\n    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important;\n    color: #e2e8f0 !important;\n    font-size: 15px !important;\n    font-weight: 600 !important;\n    letter-spacing: 0.5px !important;\n    padding: 12px 16px !important;\n    border-bottom: 1px solid #334155 !important;\n}\n\n/* Widget/card area */\n.nrdb-ui-widget-content {\n    background: #1e293b !important;\n    color: #cbd5e1 !important;\n}\n\n/* Gauge styles */\n.nrdb-ui-gauge svg text {\n    fill: #e2e8f0 !important;\n    font-family: 'Inter', sans-serif !important;\n}\n\n.nrdb-ui-gauge svg .gauge-value {\n    fill: #38bdf8 !important;\n    font-weight: 700 !important;\n    font-size: 1.4em !important;\n}\n\n/* Chart background */\n.nrdb-ui-chart canvas {\n    border-radius: 8px;\n}\n\n/* Text/label color override */\n.nrdb-ui-text {\n    color: #94a3b8 !important;\n}\n\n/* Scrollbar */\n::-webkit-scrollbar {\n    width: 6px;\n}\n::-webkit-scrollbar-track {\n    background: #0f172a;\n}\n::-webkit-scrollbar-thumb {\n    background: #334155;\n    border-radius: 3px;\n}\n::-webkit-scrollbar-thumb:hover {\n    background: #38bdf8;\n}\n</style>\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "page",
        "className": "",
        "x": 160,
        "y": 460,
        "wires": [
            []
        ]
    },
    {
        "id": "ws_prep_func",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "Format for Web",
        "func": "let p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch(e) {}\n}\nif (!p || typeof p !== 'object') {\n    p = {};\n}\n\nlet out = {\n    // Environmental\n    temperature: p.temperature !== undefined ? p.temperature : p.temp,\n    humidity: p.humidity !== undefined ? p.humidity : p.humi,\n    light: p.light !== undefined ? p.light : p.ldr,\n\n    // PZEM-004T Electrical parameters\n    voltage: p.voltage !== undefined ? p.voltage : (p.volt !== undefined ? p.volt : p.v),\n    current: p.current !== undefined ? p.current : (p.current_a !== undefined ? p.current_a : (p.amp !== undefined ? p.amp : p.i)),\n    power: p.power !== undefined ? p.power : (p.watt !== undefined ? p.watt : (p.power_w !== undefined ? p.power_w : p.p)),\n    energy: p.energy !== undefined ? p.energy : (p.kwh !== undefined ? p.kwh : (p.energy_kwh !== undefined ? p.energy_kwh : p.e)),\n    frequency: p.frequency !== undefined ? p.frequency : (p.freq !== undefined ? p.freq : (p.hz !== undefined ? p.hz : p.f)),\n    pf: p.pf !== undefined ? p.pf : (p.power_factor !== undefined ? p.power_factor : p.powerFactor),\n\n    topic: msg.topic || p.topic,\n    timestamp: Date.now()\n};\n\nmsg.payload = JSON.stringify(out);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 40,
