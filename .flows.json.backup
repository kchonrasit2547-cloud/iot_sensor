    {
        "id": "0af98798a2a62b31",
        "type": "inject",
        "z": "746e438bb151500f",
        "name": "",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{   \"temperature\": 18.5,   \"light\": 450 }",
        "payloadType": "json",
        "x": 90,
        "y": 480,
        "wires": [
            [
                "1457a55b2ef1fcb4"
            ]
        ]
    },
    {
        "id": "1457a55b2ef1fcb4",
        "type": "function",
        "z": "746e438bb151500f",
        "name": "notifications",
        "func": "const now = Date.now();\nconst TIMEOUT = 30000; // ข้อมูลหายเกิน 30 วินาที ถือว่า Disconnect\n\nconst p = msg.payload || {};\nlet alerts = [];\n\n// ⚙️ เกณฑ์แจ้งเตือนระบบไฟฟ้า 3 เฟส\nconst VOLT_MIN = 198.0;       // ไฟตก (< 198V)\nconst VOLT_MAX = 242.0;       // ไฟเกิน (> 242V)\nconst CURRENT_MAX = 15.0;     // กระแสเกินต่อเฟส (> 15A)\nconst TOTAL_POWER_MAX = 5000; // กำลังไฟฟ้ารวมเกิน (> 5000W)\n\n// ใช้เวลาไทย (Asia/Bangkok)\nconst thaiHour = Number(\n    new Intl.DateTimeFormat(\"en-GB\", {\n        timeZone: \"Asia/Bangkok\",\n        hour: \"2-digit\",\n        hourCycle: \"h23\"\n    }).format(new Date(now))\n);\n\n// ช่วงเวลา 19:00 น. ถึง 06:00 น.\nconst isNightWindow = thaiHour >= 19 || thaiHour < 6;\n\n// สถานะเริ่มต้นของ Function Node\nlet startedAt = context.get(\"startedAt\");\nif (!startedAt) {\n    startedAt = now;\n    context.set(\"startedAt\", startedAt);\n}\n\n// เช็กว่ามีข้อมูล PZEM 3 เฟส เข้ามาหรือไม่\nconst hasPzemData =\n    typeof p.totalPower === \"number\" ||\n    typeof p.voltage === \"number\" ||\n    [p.l1, p.l2, p.l3].some(phase => phase && typeof phase.voltage === \"number\");\n\nconst devices = {\n    DHT11: typeof p.temperature === \"number\" || typeof p.temp === \"number\",\n    LDR: typeof p.light === \"number\" || typeof p.lux === \"number\" || typeof p.ldr === \"number\",\n    PZEM_3Phase: hasPzemData\n};\n\n// ==========================================\n// 1. WATCHDOG CHECK (เรียกจาก Inject Node ด้วย msg.topic = \"watchdog\")\n// ==========================================\nif (msg.topic === \"watchdog\") {\n    for (const device of Object.keys(devices)) {\n        const lastSeen = context.get(\"lastSeen_\" + device);\n        const previous = context.get(\"disconnected_\" + device);\n\n        const referenceTime = lastSeen || startedAt;\n        const disconnected = now - referenceTime > TIMEOUT;\n\n        const displayName = device === \"PZEM_3Phase\" ? \"PZEM-004T (3-Phase)\" : device;\n\n        if (disconnected && previous !== true) {\n            alerts.push(`🔴 ${displayName} Disconnect: ไม่พบข้อมูลเกิน 30 วินาที`);\n        }\n\n        if (!disconnected && previous === true) {\n            alerts.push(`🟢 ${displayName} กลับมาเชื่อมต่อแล้ว`);\n        }\n\n        context.set(\"disconnected_\" + device, disconnected);\n    }\n\n    if (alerts.length === 0) return null;\n\n    msg.payload = {\n        chatId: 8602127088,\n        type: \"message\",\n        content: \"🚨 แจ้งเตือน IoT Watchdog\\n\\n\" + alerts.join(\"\\n\")\n    };\n\n    return msg;\n}\n\n// ==========================================\n// 2. บันทึกเวลาที่ได้รับข้อมูล & อัปเดตการกลับมาเชื่อมต่อ\n// ==========================================\nfor (const device of Object.keys(devices)) {\n    if (devices[device]) {\n        context.set(\"lastSeen_\" + device, now);\n\n        const displayName = device === \"PZEM_3Phase\" ? \"PZEM-004T (3-Phase)\" : device;\n\n        if (context.get(\"disconnected_\" + device) === true) {\n            context.set(\"disconnected_\" + device, false);\n            alerts.push(`🟢 ${displayName} กลับมาเชื่อมต่อแล้ว`);\n        }\n    }\n}\n\n// ==========================================\n// 3. ตรวจสอบความผิดปกติระบบไฟฟ้า 3 เฟส (L1, L2, L3)\n// ==========================================\nif (hasPzemData) {\n    const phases = [\n        { name: \"L1\", data: p.l1 },\n        { name: \"L2\", data: p.l2 },\n        { name: \"L3\", data: p.l3 }\n    ];\n\n    phases.forEach(ph => {\n        if (!ph.data) return;\n        const v = Number(ph.data.voltage || 0);\n        const i = Number(ph.data.current || 0);\n        const keyPrefix = \"pzem_alert_\" + ph.name;\n\n        // ไฟตก\n        const isVoltLow = v > 0 && v < VOLT_MIN;\n        if (isVoltLow && context.get(keyPrefix + \"_vlow\") !== true) {\n            alerts.push(`⚠️ [${ph.name}] ไฟตก: ${v.toFixed(1)} V`);\n        }\n        context.set(keyPrefix + \"_vlow\", isVoltLow);\n\n        // ไฟเกิน\n        const isVoltHigh = v > VOLT_MAX;\n        if (isVoltHigh && context.get(keyPrefix + \"_vhigh\") !== true) {\n            alerts.push(`🚨 [${ph.name}] ไฟเกิน: ${v.toFixed(1)} V`);\n        }\n        context.set(keyPrefix + \"_vhigh\", isVoltHigh);\n\n        // กระแสเกิน\n        const isCurrentHigh = i > CURRENT_MAX;\n        if (isCurrentHigh && context.get(keyPrefix + \"_ihigh\") !== true) {\n            alerts.push(`🔥 [${ph.name}] กระแสเกิน: ${i.toFixed(2)} A`);\n        }\n        context.set(keyPrefix + \"_ihigh\", isCurrentHigh);\n        \n        // ตรวจสอบกระแสใช้งาน\n        const isCurrentLow = i > 0 && i < 2.00;\n        if (isCurrentLow && context.get(keyPrefix + \"_ilow\") !== true) {\n            alerts.push(`⚡ [${ph.name}] มีการใช้ไฟ: ${i.toFixed(2)} A`);\n        }\n        context.set(keyPrefix + \"_ilow\", isCurrentLow);\n    });\n\n    // ตรวจสอบไฟขาดเฟส (Phase Loss)\n    const activeVolts = phases.map(ph => ph.data ? Number(ph.data.voltage || 0) : 0);\n    if (activeVolts.some(v => v > 100)) {\n        phases.forEach(ph => {\n            const v = ph.data ? Number(ph.data.voltage || 0) : 0;\n            const key = \"pzem_alert_\" + ph.name + \"_loss\";\n            const isLoss = v < 50;\n\n            if (isLoss && context.get(key) !== true) {\n                alerts.push(`❌ [${ph.name}] ไฟขาดเฟส! (0 V)`);\n            }\n            context.set(key, isLoss);\n        });\n    }\n\n    // ตรวจสอบกำลังไฟฟ้ารวมเกิน (Total Power Overload)\n    const totalPower = Number(p.totalPower || 0);\n    const isPowerOverload = totalPower > TOTAL_POWER_MAX;\n    if (isPowerOverload && context.get(\"pzem_alert_power_overload\") !== true) {\n        alerts.push(`💥 โหลดไฟฟ้ารวมเกินกำหนด: ${totalPower.toFixed(1)} W`);\n    }\n    context.set(\"pzem_alert_power_overload\", isPowerOverload);\n}\n\n// ==========================================\n// 4. ตรวจสอบอุณหภูมิและแสง\n// ==========================================\nconst temp = p.temperature ?? p.temp;\nconst light = p.light ?? p.lux ?? p.ldr;\n\n// ตรวจสอบอุณหภูมิ\nif (typeof temp === \"number\") {\n    // 4.1 ตรวจสอบอุณหภูมิสูงเกินเกณฑ์ (ทำงานตลอด 24 ชม.)\n    if (temp >= 30 && context.get(\"tempAlert\") !== true) {\n        alerts.push(`🌡️ อุณหภูมิสูงเกินเกณฑ์: ${temp} °C`);\n        context.set(\"tempAlert\", true);\n    } else if (temp < 27 && context.get(\"tempAlert\") === true) {\n        alerts.push(`🟢 อุณหภูมิกลับสู่สภาวะปกติ: ${temp} °C`);\n        context.set(\"tempAlert\", false);\n    }\n\n    // 4.2 ตรวจสอบการลืมปิดแอร์ (เฉพาะช่วง 19:00 - 06:00 น. และอุณหภูมิ < 25 °C)\n    if (isNightWindow) {\n        if (temp < 25 && context.get(\"acAlert\") !== true) {\n            alerts.push(`❄️ ลืมปิดแอร์! มีคนเปิดแอร์ทิ้งไว้ (อุณหภูมิ: ${temp} °C)`);\n            context.set(\"acAlert\", true);\n        } else if (temp >= 25 && context.get(\"acAlert\") === true) {\n            alerts.push(`🟢 อุณหภูมิห้องกลับสู่ระดับปกติ/ปิดแอร์แล้ว: ${temp} °C`);\n            context.set(\"acAlert\", false);\n        }\n    } else {\n        context.set(\"acAlert\", false);\n    }\n}\n\n// ตรวจสอบแสง (เฉพาะช่วง 19:00 น. ถึง 06:00 น.)\nif (isNightWindow && typeof light === \"number\") {\n    if (light > 300 && context.get(\"lightAlert\") !== true) {\n        alerts.push(`💡 เปิดไฟทิ้งไว้ (ความสว่าง: ${light} lx)`);\n        context.set(\"lightAlert\", true);\n    } else if (light <= 300) {\n        context.set(\"lightAlert\", false);\n    }\n} else if (!isNightWindow) {\n    context.set(\"lightAlert\", false);\n}\n\n// ==========================================\n// 5. จัดรูปแบบเพื่อส่ง Telegram (ถ้าไม่มีแจ้งเตือนจะส่ง null)\n// ==========================================\nif (alerts.length === 0) return null;\n\nmsg.payload = {\n    chatId: 8602127088,\n    type: \"message\",\n    content: \"🚨 แจ้งเตือนระบบ IoT\\n\\n\" + alerts.join(\"\\n\")\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
